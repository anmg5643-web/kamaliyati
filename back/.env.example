# Copy to .env locally. Replace each placeholder with the values from Atlas.
# Use Atlas's Standard connection string hosts if SRV DNS queries are blocked.
MONGO_URI=mongodb://<DB_USERNAME>:<URL_ENCODED_PASSWORD>@<HOST_0>:27017,<HOST_1>:27017,<HOST_2>:27017/kamaliyati?tls=true&replicaSet=<REPLICA_SET>&authSource=admin&retryWrites=true&w=majority
ADMIN_USERNAME=admin
ADMIN_PASSWORD=<SET_A_RANDOM_PASSWORD_OF_AT_LEAST_16_CHARACTERS_FOR_PRODUCTION>
JWT_SECRET=<SET_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS>
PORT=3001
